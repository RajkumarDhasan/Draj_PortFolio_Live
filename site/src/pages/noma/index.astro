---
// Noma case study: a real project that has not been released. Never called a
// practice project or a shipped app. Sources: the Noma Figma file (every screen
// in English and Arabic, LTR/RTL components, variable-driven prototype).
// Not used (unverified): café visits, interviews, personas with quotes,
// the client's location, component and variable counts.
import CaseStudy from '../../layouts/CaseStudy.astro';
import Chapter from '../../components/case/Chapter.astro';
import Notes from '../../components/case/Notes.astro';
import Screens from '../../components/case/Screens.astro';
import LangSwitch from '../../components/case/LangSwitch.astro';
import Callout from '../../components/case/Callout.astro';
import NomaSystem from '../../components/case/NomaSystem.astro';
import { projects } from '../../data/projects';
import type { ImageMetadata } from 'astro';

const project = projects[2];
const base = import.meta.env.BASE_URL;

const img = import.meta.glob<{ default: ImageMetadata }>('../../assets/noma/*.png', { eager: true });
const pick = (name: string) => img[`../../assets/noma/${name}.png`].default;

const decisions = [
  { id: 'builder', title: 'Make customisation the main path' },
  { id: 'flow', title: 'One decision per bottom sheet, pickup first' },
  { id: 'states', title: 'Design the states nobody asks for' },
  { id: 'rtl', title: 'Build reading direction into the components' },
];
const chapters = [
  { id: 'product', title: 'The product and my role' },
  ...decisions,
  { id: 'system', title: 'Design system and prototype' },
];

const flowText: [string, string, string][] = [
  ['Home', 'Greeting, search and today’s featured drink on one screen, with Customize on the card.', 'Noma home: greeting, search, today’s pour card for Honey Oat Latte at AED 27 with Customize, and browse by mood.'],
  ['Search with no results', 'A search miss offers a reset instead of a dead end.', 'Menu search for oat croissant with no items found and a Reset filters button.'],
  ['Added to order', 'A toast confirms the add without leaving the menu.', 'Home with a confirmation toast: Flat White added to your order.'],
  ['Customise', 'Size, milk and an extra shot in one bottom sheet, with the price on the only primary button.', 'Bottom sheet Make it yours for a flat white: size, milk type, extra espresso shot and Add to order · AED 22.'],
  ['Filter', 'Narrow the menu by price in one sheet.', 'Filter menu bottom sheet with price options and Show 10 items.'],
  ['Sort', 'Sort options in their own sheet, one choice at a time.', 'Sort menu bottom sheet: popular, price low to high, price high to low, name.'],
  ['Your order', 'Recipe, quantity steppers and totals together.', 'Your order: flat white and Spanish latte with quantity steppers, subtotal, pickup fee and total AED 74.'],
  ['Empty order', 'One clear way back to the menu.', 'Your order is empty, with a Browse menu button.'],
  ['Confirm pickup', 'Store, pickup name and payment on one screen before placing the order.', 'Confirm pickup: store Noma Jumeirah with opening hours, name for pickup, and payment method choices.'],
  ['Payment missing', 'An inline message, with every other choice kept.', 'Payment method section with an inline error asking to choose a payment method to continue.'],
  ['Order placed', 'Reference number, receipt and a way back.', 'Thanks, Noor. Order placed with reference number, items and total, Back to home and Cancel order.'],
  ['Profile', 'Preferred store and order preferences.', 'Profile for Noor Ahmed with preferred store and order preferences.'],
];
const flowEn = flowText.map(([title, caption, alt], i) => ({ image: pick(`flow-en-${String(i + 1).padStart(2, '0')}`), title, caption, alt }));
const flowAr = flowText.map(([title, caption, alt], i) => ({ image: pick(`flow-ar-${String(i + 1).padStart(2, '0')}`), title, caption, alt: `Arabic version. ${alt}` }));

const stateText: [string, string, string][] = [
  ['Choose a store', 'Use the current location or pick a branch, each with distance and opening time.', 'Choose your location sheet: use my current location or one of several Noma branches with ready times.'],
  ['Loading', 'Skeletons hold the layout while the menu loads.', 'Home with grey skeleton placeholders while the menu loads.'],
  ['Menu failed to load', 'Explains the failure and offers a retry.', 'We couldn’t load the menu, with an explanation and a Try again button.'],
  ['Offline and sold out', 'A connection banner, and unavailable items marked instead of hidden.', 'Offline banner above the menu, with a sold-out item marked.'],
  ['Limit reached', 'The stepper stops at the limit and says why.', 'Your order with a message: you can order up to 5 of the same drink.'],
  ['Undo', 'Undo, for the tap you did not mean.', 'Your order with a toast: Flat White removed, Undo.'],
  ['Card declined', 'Keeps the order and asks for another method.', 'Confirm pickup with an inline message: your card was declined and you weren’t charged.'],
  ['Offline at checkout', 'The order is kept until the connection returns.', 'Confirm pickup while offline, with a message that the order is saved.'],
  ['Placing order', 'A progress state, so nobody taps twice.', 'Confirm pickup with the Place order button showing Placing order….'],
];
const statesEn = stateText.map(([title, caption, alt], i) => ({ image: pick(`states-en-0${i + 1}`), title, caption, alt }));
const statesAr = stateText.map(([title, caption, alt], i) => ({ image: pick(`states-ar-0${i + 1}`), title, caption, alt: `Arabic version. ${alt}` }));
---

<CaseStudy
  project={project}
  lead="A pickup ordering app for a coffee shop. Customers order from the menu or build a drink ingredient by ingredient, then collect it from the store they choose."
  meta={[
    { label: 'Product status', value: 'Not yet released' },
    { label: 'My role', value: 'UX/UI designer' },
    { label: 'Languages', value: 'English and Arabic' },
    { label: 'Platform', value: 'Mobile app' },
  ]}
  designed={[
    'Every screen in English and Arabic: the ordering flow, the drink builder and nine states',
    'Low-fidelity wireframes, each with notes on the reasoning',
    'A component library where each component has left-to-right and right-to-left variants',
    'A prototype run by Figma variables: cart, builder, orders and location',
  ]}
  decisions={decisions}
  chapters={chapters}
  headerScreens={project.screens}
  next={{ href: `${base}taggo/`, name: 'Taggo', promise: projects[0].promise }}
>
  <Chapter id="product" title="The product and my role">
    <p>
      Noma is a pickup ordering app for a coffee shop. Customers browse the menu by category or mood, or build their own
      drink step by step, then choose a store, add a pickup name and pay. The app is designed in English and Arabic.
    </p>
    <p>
      I designed the product in Figma: wireframes, the English and Arabic interface, the component library and a
      working prototype. Noma has not been released yet.
    </p>
  </Chapter>

  <Chapter id="builder" label="Decision 1" title="Make customisation the main path">
    <Notes
      items={[
        { term: 'The problem', text: 'Coffee orders are personal. A hidden notes field makes customisation an afterthought and leaves the customer unsure what they will get.' },
        { term: 'What I designed', text: 'A drink builder: milk, sugar, coffee and ice are added step by step, a cup illustration fills as each one is added, the recipe reads back in plain words, and the running price sits on the only primary button.' },
        { term: 'Why', text: 'Every tap has a visible result, and the price is never a surprise. The same builder handles iced drinks by adding ice as an ingredient.' },
        { term: 'Still to test', text: 'How long a typical custom drink takes to build on a phone.' },
      ]}
    />
    <Screens
      size="sm"
      items={[
        { image: pick('wire-02'), alt: 'Low-fidelity wireframe of the builder: a cup placeholder, coffee powder and milk steppers, and an Add to order button.', title: 'Wireframe', caption: 'The idea before the visuals: a cup that changes with each step, and one primary button.' },
        { image: pick('builder-en-01'), alt: 'Builder default recipe for a flat white: an empty cup, no milk, no sugar, Add to order · AED 22.', title: 'Default recipe', caption: 'The builder opens on the drink’s default recipe and base price.' },
        { image: pick('builder-en-02'), alt: 'Builder with oat milk and three spoons of coffee: the cup shows coffee and milk layers, Add to order · AED 30.', title: 'Customised', caption: 'Each choice fills the cup and updates the price on the button.' },
        { image: pick('builder-en-03'), alt: 'Builder for an iced americano with ice and coffee, Add to order · AED 22.', title: 'Iced drink', caption: 'Ice becomes one more ingredient, so iced drinks use the same builder.' },
      ]}
    />
  </Chapter>

  <Chapter id="flow" label="Decision 2" title="One decision per bottom sheet, pickup first">
    <Notes
      items={[
        { term: 'The problem', text: 'Ordering ahead means many small choices (size, milk, filters, store, payment), and long forms make them hard to scan.' },
        { term: 'What I designed', text: 'Each choice opens its own bottom sheet over the menu, so the customer never loses their place. Checkout is built around pickup: store, pickup name and payment on one screen, then an order reference to show at the counter.' },
        { term: 'Why', text: 'One decision at a time keeps each screen short, and the order reference answers the customer’s real question: where and when to collect.' },
      ]}
    />
    <LangSwitch id="flow" label="Show the 12-screen ordering flow in" en={flowEn} ar={flowAr} />
  </Chapter>

  <Chapter id="states" label="Decision 3" title="Design the states nobody asks for">
    <Notes
      items={[
        { term: 'The problem', text: 'Real use includes slow connections, sold-out items, mistakes and declined cards. Left undesigned, these become dead ends.' },
        { term: 'What I designed', text: 'Nine states, each telling the customer what happened and giving one clear way forward, in both languages.' },
        { term: 'Why', text: 'Every state keeps the customer’s choices, so recovering never means starting the order again.' },
      ]}
    />
    <LangSwitch id="states" label="Show the states in" en={statesEn} ar={statesAr} />
  </Chapter>

  <Chapter id="rtl" label="Decision 4" title="Build reading direction into the components">
    <Notes
      items={[
        { term: 'The problem', text: 'Arabic added after the English design usually means redrawing screens and inconsistent mirroring.' },
        { term: 'What I designed', text: 'Every component has a left-to-right and a right-to-left variant. Layout, steppers and progress follow the reading direction; directional icons such as back arrows mirror, while cups, bags and checkmarks stay as they are. Prices read in dirhams in both languages.' },
        { term: 'Why', text: 'The Arabic flow becomes a matter of switching variants, so both languages stay in step as the design changes.' },
      ]}
    />
    <Screens
      size="sm"
      items={[
        { image: pick('builder-en-04'), alt: 'English builder for a flat white, customised, Add to order · AED 31.', title: 'Builder, English', caption: 'Left to right: steps, steppers and the recipe line.' },
        { image: pick('builder-ar-04'), alt: 'Arabic builder for the same flat white, mirrored right to left, with the price on the button.', title: 'Builder, Arabic', caption: 'The same component in its right-to-left variant: order, steppers and progress mirror; the cup does not.' },
        { image: pick('flow-en-07'), alt: 'English order screen with two drinks, quantity steppers and totals.', title: 'Order, English', caption: 'Quantities and totals in the left-to-right layout.' },
        { image: pick('flow-ar-07'), alt: 'Arabic order screen with the same two drinks, mirrored.', title: 'Order, Arabic', caption: 'The same screen mirrored, with prices in dirhams.' },
      ]}
    />
    <Callout>The Arabic text in these designs is an AI-assisted translation.</Callout>
  </Chapter>

  <Chapter id="system" title="Design system and prototype">
    <p>
      The design system lives in Figma variables (colour, spacing and radius), and a second layer of variables runs the
      prototype: cart, builder, orders and location. That lets people click through real quantities, prices and errors
      before any code exists.
    </p>
    <NomaSystem />
    <h3>Deliverables</h3>
    <ul>
      <li>English and Arabic screens: ordering flow, drink builder and states</li>
      <li>Annotated low-fidelity wireframes</li>
      <li>A component library with left-to-right and right-to-left variants</li>
      <li>A variable-driven prototype</li>
    </ul>
  </Chapter>
</CaseStudy>
