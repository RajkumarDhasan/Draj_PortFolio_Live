---
import '@fontsource-variable/bricolage-grotesque';
import '@fontsource-variable/instrument-sans';
import '../styles/global.css';
import SiteHeader from '../components/SiteHeader.astro';

interface Props {
  title: string;
  description: string;
  home?: boolean;
  /** Marks the matching header link with aria-current="page" */
  current?: 'about';
}

const { title, description, home = false, current } = Astro.props;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="theme-color" content="#17130f" />
    <link rel="icon" href="data:," />
    <script is:inline>
      (function () {
        var d = document.documentElement;
        d.classList.add('js');
        var theme = 'dark';
        try {
          var saved = localStorage.getItem('portfolio-theme');
          theme = saved === 'light' || saved === 'dark'
            ? saved
            : (window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark');
        } catch (e) {
          theme = window.matchMedia('(prefers-color-scheme: light)').matches ? 'light' : 'dark';
        }
        d.dataset.theme = theme;
        document.querySelector('meta[name="theme-color"]').setAttribute('content', theme === 'light' ? '#f7f4ef' : '#17130f');
        // Safety net: if the motion script never runs, show content in place.
        setTimeout(function () {
          if (!d.classList.contains('js-ready')) d.classList.add('no-motion-fallback');
        }, 3000);
      })();
    </script>
    <slot name="head" />
  </head>
  <body id="top">
    <a class="skip-link" href="#main">Skip to content</a>
    <slot name="overlay" />
    <SiteHeader home={home} current={current} />
    <main id="main" tabindex="-1">
      <slot />
    </main>
  </body>
</html>
