---
// Shared case-study layout: a quick-scan opening (what it is, status, role,
// what I designed, linked key decisions), then chapters with a sticky
// "On this page" list on wide screens, then the next project.
import { Image } from 'astro:assets';
import Base from './Base.astro';
import Device from '../components/Device.astro';
import type { ProjectSummary, Screen } from '../data/projects';

interface Props {
  project: ProjectSummary;
  lead: string;
  meta: { label: string; value: string }[];
  note?: string;
  designed: string[];
  decisions: { id: string; title: string }[];
  chapters: { id: string; title: string }[];
  headerScreens: Screen[];
  /** Taggo: open on the screen the visitor last saw on the homepage */
  rememberScreen?: boolean;
  next: { href: string; name: string; promise: string };
}

const { project, lead, meta, note, designed, decisions, chapters, headerScreens, rememberScreen = false, next } =
  Astro.props;
const base = import.meta.env.BASE_URL;
---

<Base title={`${project.name} case study, Rajkumar Dhasan`} description={lead}>
  {
    rememberScreen && (
      <Fragment slot="head">
        <script is:inline>
          (function () {
            try {
              var v = sessionStorage.getItem('taggo-screen');
              if (v !== null && /^[0-5]$/.test(v)) document.documentElement.setAttribute('data-screen', v);
            } catch (e) {}
          })();
        </script>
      </Fragment>
    )
  }

  <article class="case" style={`--accent: ${project.accent}; --on-accent: ${project.onAccent};`}>
    <header class="case-hero">
      <div class="wrap case-hero__grid">
        <div class="case-hero__text">
          <a class="case-hero__back" href={`${base}#work`}>All work</a>
          <p class="case-hero__label">
            {project.logo && <Image src={project.logo} alt="" width={64} class="case-hero__logo" />}
            <span>{project.category}</span>
          </p>
          <h1 class="case-hero__title">{project.name}</h1>
          <p class="case-hero__lead">{lead}</p>
          <dl class="case-hero__meta">
            {
              meta.map((m) => (
                <div>
                  <dt>{m.label}</dt>
                  <dd>{m.value}</dd>
                </div>
              ))
            }
          </dl>
          {note && <p class="case-hero__note">{note}</p>}
        </div>
        <div class="case-hero__media" data-remember={rememberScreen ? 'true' : undefined}>
          <div class="case-hero__glow" aria-hidden="true"></div>
          <Device
            steps={headerScreens}
            mode="static"
            transition={project.transitionName}
            decorative
            eager
          />
        </div>
      </div>
    </header>

    <div class="paper">
      <section class="case-summary" aria-label={`${project.name} at a glance`}>
        <div class="wrap case-summary__grid">
          <div>
            <h2 class="case-summary__title">What I designed</h2>
            <ul class="case-summary__list">
              {designed.map((d) => <li>{d}</li>)}
            </ul>
          </div>
          <div>
            <h2 class="case-summary__title">Key decisions</h2>
            <ol class="case-summary__decisions">
              {
                decisions.map((d) => (
                  <li>
                    <a href={`#${d.id}`}>{d.title}</a>
                  </li>
                ))
              }
            </ol>
          </div>
        </div>
      </section>

      <div class="wrap case-body">
        <nav class="case-nav" aria-label="On this page">
          <p class="case-nav__title">On this page</p>
          <ol>
            {
              chapters.map((c) => (
                <li>
                  <a href={`#${c.id}`}>{c.title}</a>
                </li>
              ))
            }
          </ol>
        </nav>
        <div class="case-content">
          <slot />
        </div>
      </div>

      <nav class="case-next" aria-label="Next project">
        <div class="wrap">
          <p class="case-next__label">Next project</p>
          <a class="case-next__link" href={next.href}>
            <span class="case-next__name">{next.name}</span>
            <span class="case-next__promise">{next.promise}</span>
          </a>
        </div>
      </nav>
    </div>
  </article>
</Base>

<script>
  document.documentElement.classList.add('js-ready');
</script>

<style>
  /* ---------- Opening (dark stage) ---------- */
  .case-hero {
    --device-w: min(62vw, 18rem);
    position: relative;
    overflow: clip;
    padding-top: calc(var(--header-h) + clamp(2rem, 1rem + 5vh, 5rem));
    padding-bottom: clamp(5rem, 2.5rem + 9vh, 9rem);
  }
  @media (min-width: 768px) {
    .case-hero { --device-w: clamp(14rem, (100svh - var(--header-h) - 10rem) * 0.42, 19rem); }
  }
  .case-hero__grid {
    display: grid;
    gap: 3rem;
    align-items: center;
  }
  @media (min-width: 768px) {
    .case-hero__grid { grid-template-columns: minmax(0, 1fr) auto; gap: clamp(3rem, 7vw, 8rem); }
  }
  .case-hero__text { max-width: 40rem; }
  .case-hero__back {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    margin-bottom: 1rem;
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--ink-soft);
    text-underline-offset: 0.3em;
  }
  .case-hero__label {
    display: flex;
    align-items: center;
    gap: 0.625rem;
    margin-bottom: 1rem;
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--ink-muted);
  }
  .case-hero__label :global(.case-hero__logo) {
    width: 32px;
    height: 32px;
    border-radius: 8px;
    object-fit: cover;
  }
  .case-hero__title {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-project);
    line-height: 1;
    letter-spacing: -0.02em;
  }
  .case-hero__lead {
    margin-top: 1.25rem;
    font-size: var(--fs-lead);
    line-height: 1.45;
    color: var(--ink-soft);
  }
  .case-hero__meta {
    display: grid;
    grid-template-columns: repeat(auto-fit, minmax(11rem, 1fr));
    gap: 1.25rem 2rem;
    margin: 2rem 0 0;
    padding-top: 1.5rem;
    border-top: 1px solid var(--line);
  }
  .case-hero__meta dt {
    font-size: var(--fs-label);
    font-weight: 500;
    color: var(--ink-muted);
  }
  .case-hero__meta dd {
    margin: 0.25rem 0 0;
    font-size: 1rem;
    line-height: 1.45;
  }
  .case-hero__note {
    margin-top: 1.5rem;
    max-width: 36rem;
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: var(--ink-muted);
  }
  .case-hero__media {
    position: relative;
    isolation: isolate;
    display: grid;
    justify-items: center;
  }
  .case-hero__glow {
    position: absolute;
    z-index: -1;
    top: 50%;
    left: 50%;
    width: calc(var(--device-w) * 2.4);
    aspect-ratio: 1;
    translate: -50% -50%;
    background: radial-gradient(
      closest-side,
      color-mix(in srgb, var(--accent) 20%, transparent),
      color-mix(in srgb, var(--accent) 7%, transparent) 50%,
      transparent 100%
    );
  }

  /* Taggo: show the remembered screen (default: the first) */
  .case-hero__media[data-remember] :global(.device__img) { opacity: 0; transform: none; transition: none; }
  .case-hero__media[data-remember] :global(.device__img[data-screen-index='0']) { opacity: 1; }
  :global(html[data-screen]) .case-hero__media[data-remember] :global(.device__img[data-screen-index='0']) { opacity: 0; }
  :global(html[data-screen='0']) .case-hero__media[data-remember] :global(.device__img[data-screen-index='0']),
  :global(html[data-screen='1']) .case-hero__media[data-remember] :global(.device__img[data-screen-index='1']),
  :global(html[data-screen='2']) .case-hero__media[data-remember] :global(.device__img[data-screen-index='2']),
  :global(html[data-screen='3']) .case-hero__media[data-remember] :global(.device__img[data-screen-index='3']),
  :global(html[data-screen='4']) .case-hero__media[data-remember] :global(.device__img[data-screen-index='4']),
  :global(html[data-screen='5']) .case-hero__media[data-remember] :global(.device__img[data-screen-index='5']) { opacity: 1; }

  /* ---------- Paper (long reading) ---------- */
  .paper {
    background: var(--paper);
    color: var(--paper-ink);
  }
  .paper :global(:focus-visible) { outline-color: var(--paper-ink); }
  .paper :global(a) { color: var(--paper-ink); }

  .case-summary {
    padding-block: clamp(5rem, 2.5rem + 8vh, 8rem);
    border-bottom: 1px solid var(--paper-line);
  }
  .case-summary__grid {
    display: grid;
    gap: 2.5rem;
  }
  @media (min-width: 900px) {
    .case-summary__grid { grid-template-columns: minmax(0, 7fr) minmax(0, 5fr); gap: clamp(3rem, 7vw, 7rem); }
  }
  .case-summary__title {
    font-size: var(--fs-decision);
    font-weight: 600;
    line-height: 1.3;
  }
  .case-summary__list {
    list-style: none;
    margin-top: 1rem;
    display: grid;
    gap: 0.75rem;
  }
  .case-summary__list li {
    position: relative;
    padding-left: 1.25rem;
    color: var(--paper-soft);
  }
  .case-summary__list li::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.75em;
    width: 0.5rem;
    height: 2px;
    background: var(--paper-ink);
  }
  .case-summary__decisions {
    margin-top: 1rem;
    padding-left: 1.5rem;
    display: grid;
    gap: 0.5rem;
  }
  .case-summary__decisions li::marker {
    color: var(--paper-muted);
    font-variant-numeric: tabular-nums;
  }
  .case-summary__decisions a {
    display: inline-block;
    padding-block: 0.375rem;
    font-weight: 500;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.25em;
  }
  .case-summary__decisions a:hover { text-decoration-thickness: 2px; }

  .case-body {
    display: grid;
    gap: 0;
    padding-block: clamp(3rem, 1.5rem + 6vh, 6rem) clamp(6rem, 3rem + 10vh, 10rem);
  }
  @media (min-width: 1100px) {
    .case-body {
      grid-template-columns: 13rem minmax(0, 1fr);
      gap: clamp(3rem, 5vw, 5rem);
    }
  }
  .case-nav { display: none; }
  @media (min-width: 1100px) {
    .case-nav {
      display: block;
      position: sticky;
      top: calc(var(--header-h) + 2rem);
      align-self: start;
      padding-top: clamp(2rem, 1rem + 3vh, 3.5rem);
    }
  }
  .case-nav__title {
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--paper-muted);
  }
  .case-nav ol {
    list-style: none;
    margin-top: 0.75rem;
    display: grid;
    gap: 0.125rem;
  }
  .case-nav a {
    display: block;
    padding: 0.375rem 0 0.375rem 0.75rem;
    border-left: 2px solid var(--paper-line);
    font-size: 0.9375rem;
    line-height: 1.4;
    color: var(--paper-soft);
    text-decoration: none;
  }
  .case-nav a:hover { border-left-color: var(--paper-ink); color: var(--paper-ink); }
  .case-content { min-width: 0; }

  .case-next {
    border-top: 1px solid var(--paper-line);
    padding-block: clamp(5rem, 2.5rem + 8vh, 8rem);
  }
  .case-next__label {
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--paper-muted);
  }
  .case-next__link {
    display: inline-grid;
    gap: 0.5rem;
    margin-top: 0.75rem;
    text-decoration: none;
  }
  .case-next__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: var(--fs-section);
    line-height: 1.15;
    text-decoration: underline;
    text-decoration-thickness: 2px;
    text-underline-offset: 0.2em;
  }
  .case-next__promise { color: var(--paper-soft); max-width: 36rem; }
</style>
