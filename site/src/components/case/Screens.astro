---
// Real screens with captions that explain the decision, not just the screen name.
// Every standalone mobile screen sits in the shared iPhone frame (Device.astro).
// Multi-screen boards use Board.astro instead and stay flat.
import type { ImageMetadata } from 'astro';
import Device from '../Device.astro';

interface Props {
  items: { image: ImageMetadata; alt: string; title: string; caption: string }[];
  /** Narrower columns fit more phones per row */
  size?: 'sm' | 'md';
}
const { items, size = 'md' } = Astro.props;
const sizes =
  size === 'sm'
    ? '(min-width: 1100px) 200px, (min-width: 600px) 28vw, 44vw'
    : '(min-width: 1100px) 240px, (min-width: 600px) 30vw, 44vw';
---

<ol class:list={['screens', `screens--${size}`]}>
  {
    items.map((s) => (
      <li>
        <figure class="screen">
          <div class="screen__phone">
            <Device steps={[{ image: s.image, alt: s.alt }]} mode="static" surface="paper" sizes={sizes} />
          </div>
          <figcaption>
            <strong>{s.title}</strong>
            <span>{s.caption}</span>
          </figcaption>
        </figure>
      </li>
    ))
  }
</ol>

<style>
  .screens {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 3.5rem 2rem;
    grid-template-columns: repeat(auto-fill, minmax(min(14rem, 100%), 1fr));
  }
  .screens--sm { grid-template-columns: repeat(auto-fill, minmax(min(11.5rem, 100%), 1fr)); }
  @media (max-width: 599px) {
    .screens,
    .screens--sm { grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 2.75rem 1rem; }
  }
  .screen { margin: 0; }
  .screen__phone {
    --device-w: min(100%, 15rem);
    display: flex;
    justify-content: center;
  }
  .screen__phone :global(.device) { width: 100%; max-width: 15rem; }
  figcaption {
    display: grid;
    gap: 0.25rem;
    margin-top: 1rem;
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: var(--paper-soft);
  }
  figcaption strong {
    font-weight: 600;
    color: var(--paper-ink);
  }
</style>
