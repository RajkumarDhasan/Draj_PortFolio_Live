---
// A wide working board (wireframes) shown full width, with a link to the full-size file.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

interface Props {
  image: ImageMetadata;
  alt: string;
  title: string;
  caption: string;
}
const { image, alt, title, caption } = Astro.props;
---

<figure class="board">
  <div class="board__frame">
    <Image
      src={image}
      alt={alt}
      widths={[900, Math.min(1800, image.width)]}
      sizes="(min-width: 1100px) 64rem, 100vw"
      quality={80}
      loading="lazy"
      decoding="async"
    />
  </div>
  <figcaption>
    <strong>{title}</strong>
    <span>{caption}</span>
    <a href={image.src} target="_blank" rel="noopener">Open the full-size board<span class="visually-hidden"> (opens in a new tab)</span></a>
  </figcaption>
</figure>

<style>
  .board { margin: 0; }
  .board__frame {
    overflow: hidden;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 0 0 1px var(--paper-line);
  }
  .board__frame :global(img) { width: 100%; height: auto; }
  figcaption {
    display: grid;
    gap: 0.25rem;
    max-width: 44rem;
    margin-top: 0.875rem;
    font-size: var(--fs-caption);
    line-height: 1.5;
    color: var(--paper-soft);
  }
  figcaption strong { font-weight: 600; color: var(--paper-ink); }
  figcaption a {
    justify-self: start;
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-underline-offset: 0.25em;
  }
</style>
