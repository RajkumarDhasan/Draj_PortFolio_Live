---
// Design-system evidence for a case study, rendered from values read in the
// project's Figma file (variables, text styles and component properties).
// Nothing here is a mood board: every swatch, size and radius is a recorded
// value, and each group has a caption saying what decision it supports.
interface Swatch {
  token: string;
  hex: string;
  /** Dark-mode value, when the variable has one */
  dark?: string;
  role: string;
}
interface TypeStyle {
  style: string;
  spec: string;
  size: number;
  weight: number;
  sample: string;
  lang?: string;
}
interface Props {
  id: string;
  variant: 'taggo' | 'theevents' | 'noma';
  colors: Swatch[];
  colorNote: string;
  /** Labels for the two halves when swatches carry a dark value */
  modes?: [string, string];
  type: TypeStyle[];
  typeFamily: string;
  typeStack: string;
  typeNote: string;
  spacing?: number[];
  spacingName?: string;
  radius: { name: string; value: number }[];
  scaleNote: string;
}
const { id, variant, colors, colorNote, modes, type, typeFamily, typeStack, typeNote, spacing, spacingName, radius, scaleNote } =
  Astro.props;
const maxSpace = spacing && spacing.length ? Math.max(...spacing) : 0;
---

<div class:list={['sys', `sys--${variant}`]} style={`--type-stack: ${typeStack}`}>
  <section class="sys__group" aria-labelledby={`${id}-color`}>
    <h3 id={`${id}-color`}><span class="sys__index" aria-hidden="true">01</span>Colour</h3>
    <p class="sys__note">{colorNote}</p>
    {modes && (
      <p class="sys__modes" aria-hidden="true">
        <span><i class="sys__key sys__key--light"></i>{modes[0]}</span>
        <span><i class="sys__key sys__key--dark"></i>{modes[1]}</span>
      </p>
    )}
    <ul class="sys__swatches">
      {
        colors.map((c) => (
          <li class="sys__swatch">
            <span class:list={['sys__chip', c.dark && 'sys__chip--split']} aria-hidden="true">
              <span style={`background:${c.hex}`} />
              {c.dark && <span style={`background:${c.dark}`} />}
            </span>
            <span class="sys__token">{c.token}</span>
            <span class="sys__hex">
              {c.dark && modes ? (
                <>
                  <span class="visually-hidden">{modes[0]}: </span>
                  {c.hex}
                  {' · '}
                  <span class="visually-hidden">{modes[1]}: </span>
                  {c.dark}
                </>
              ) : (
                c.hex
              )}
            </span>
            <span class="sys__role">{c.role}</span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sys__group" aria-labelledby={`${id}-type`}>
    <h3 id={`${id}-type`}><span class="sys__index" aria-hidden="true">02</span>Typography · {typeFamily}</h3>
    <p class="sys__note">{typeNote}</p>
    <ul class="sys__type">
      {
        type.map((t) => (
          <li>
            <span class="sys__type-meta">
              <strong>{t.style}</strong>
              {' '}
              <span>{t.spec}</span>
            </span>
            <span class="sys__type-sample" lang={t.lang} style={`font-size:${t.size}px;font-weight:${t.weight}`}>
              {t.sample}
            </span>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="sys__group" aria-labelledby={`${id}-scale`}>
    <h3 id={`${id}-scale`}><span class="sys__index" aria-hidden="true">03</span>Spacing and radius</h3>
    <p class="sys__note">{scaleNote}</p>
    <div class:list={['sys__scales', !spacing?.length && 'sys__scales--one']}>
      {spacing && spacing.length > 0 && (
      <div>
        <p class="sys__sub">{spacingName}</p>
        <ul class="sys__space">
          {
            spacing.map((v) => (
              <li>
                <span class="sys__space-val">{v}</span>
                <span class="sys__bar" style={`width:${(v / maxSpace) * 100}%`} aria-hidden="true" />
              </li>
            ))
          }
        </ul>
      </div>
      )}
      <div>
        <p class="sys__sub">Corner radius (px)</p>
        <ul class="sys__radius">
          {
            radius.map((r) => (
              <li>
                <span class="sys__radius-box" style={`border-radius:${Math.min(r.value, 28)}px`} aria-hidden="true" />
                <span class="sys__radius-name">{r.name}</span>
                <span class="sys__radius-val">{r.value >= 999 ? 'full (999)' : `${r.value}`}</span>
              </li>
            ))
          }
        </ul>
      </div>
    </div>
  </section>

  <section class="sys__group" aria-labelledby={`${id}-components`}>
    <h3 id={`${id}-components`}><span class="sys__index" aria-hidden="true">04</span>Components and states</h3>
    <slot />
  </section>
</div>

<style>
  .sys {
    display: grid;
    gap: clamp(4rem, 2.5rem + 4vw, 6rem);
    margin-top: 2rem;
  }
  .sys__group h3 {
    font-size: var(--fs-decision);
    font-weight: 600;
    line-height: 1.3;
    color: var(--paper-ink);
  }
  .sys__index { display: none; }
  .sys__note {
    max-width: 44rem;
    margin-top: 0.5rem;
    color: var(--paper-soft);
  }
  .sys__sub {
    margin-bottom: 0.75rem;
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--paper-muted);
  }
  .sys__modes {
    display: flex;
    gap: 1.25rem;
    margin-top: 1rem;
    font-size: var(--fs-caption);
    color: var(--paper-muted);
  }
  .sys__modes span { display: inline-flex; align-items: center; gap: 0.4rem; }
  .sys__key {
    width: 0.875rem;
    height: 0.875rem;
    border-radius: 3px;
    box-shadow: inset 0 0 0 1px rgba(30, 25, 20, 0.25);
  }
  .sys__key--light { background: linear-gradient(135deg, #fff 50%, transparent 50%); }
  .sys__key--dark { background: linear-gradient(135deg, transparent 50%, #262626 50%); }

  .sys__swatches {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    display: grid;
    gap: 1.25rem 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(10.5rem, 100%), 1fr));
  }
  @media (max-width: 479px) {
    .sys__swatches { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  }
  .sys__swatch {
    display: grid;
    gap: 0.2rem;
    align-content: start;
    font-size: var(--fs-caption);
    line-height: 1.4;
  }
  .sys__chip {
    display: flex;
    height: 3.5rem;
    margin-bottom: 0.5rem;
    overflow: hidden;
    border-radius: 10px;
    box-shadow: inset 0 0 0 1px rgba(30, 25, 20, 0.12);
  }
  .sys__chip > span { flex: 1; box-shadow: inset 0 0 0 1px rgba(30, 25, 20, 0.08); }
  .sys__token {
    font-weight: 600;
    color: var(--paper-ink);
    overflow-wrap: anywhere;
  }
  .sys__hex {
    font-family: ui-monospace, 'SF Mono', Menlo, Consolas, monospace;
    font-size: 0.8125rem;
    color: var(--paper-soft);
  }
  .sys__role { color: var(--paper-muted); }

  .sys__type {
    list-style: none;
    padding: 0;
    margin-top: 1.25rem;
    border-top: 1px solid var(--paper-line);
  }
  .sys__type li {
    display: grid;
    gap: 0.25rem 1.5rem;
    align-items: baseline;
    padding-block: 0.875rem;
    border-bottom: 1px solid var(--paper-line);
  }
  @media (min-width: 700px) {
    .sys__type li { grid-template-columns: 14rem minmax(0, 1fr); }
  }
  .sys__type-meta { font-size: var(--fs-caption); color: var(--paper-muted); }
  .sys__type-meta strong { color: var(--paper-ink); font-weight: 600; }
  .sys__type-sample {
    font-family: var(--type-stack);
    line-height: 1.25;
    color: var(--paper-ink);
    overflow-wrap: anywhere;
  }

  .sys__scales {
    display: grid;
    gap: 2rem;
    margin-top: 1.25rem;
  }
  @media (min-width: 760px) {
    .sys__scales:not(.sys__scales--one) { grid-template-columns: minmax(0, 1fr) minmax(0, 1fr); gap: 3rem; }
  }
  .sys__space { list-style: none; padding: 0; display: grid; gap: 0.5rem; }
  .sys__space li {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    align-items: center;
    gap: 0.75rem;
    font-size: var(--fs-caption);
    font-variant-numeric: tabular-nums;
    color: var(--paper-soft);
  }
  .sys__bar {
    display: block;
    height: 0.75rem;
    min-width: 2px;
    border-radius: 2px;
    background: var(--sys-accent, var(--paper-ink));
  }
  .sys__radius {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 1rem 1.25rem;
  }
  .sys__radius li {
    display: grid;
    justify-items: start;
    gap: 0.2rem;
    font-size: var(--fs-caption);
  }
  .sys__radius-box {
    width: 3.5rem;
    height: 3.5rem;
    margin-bottom: 0.4rem;
    border: 2px solid var(--paper-ink);
    background: var(--paper-raised);
  }
  .sys__radius-name { font-weight: 600; color: var(--paper-ink); }
  .sys__radius-val { color: var(--paper-muted); font-variant-numeric: tabular-nums; }

  /* Taggo reads like a controlled product specification. The rider and driver
     apps share token names and state rules, so each foundation gets a numbered sheet. */
  .sys--taggo { gap: 1.5rem; }
  .sys--taggo .sys__group {
    min-width: 0;
    padding: clamp(1.25rem, 1rem + 2vw, 2.5rem);
    border: 1px solid #d7d5c9;
    border-top: 5px solid #f0dd50;
    background: #fffefa;
  }
  .sys--taggo .sys__group h3 { display: flex; align-items: baseline; gap: 0.8rem; }
  .sys--taggo .sys__index {
    display: inline-block;
    flex: none;
    padding: 0.25rem 0.4rem;
    border-radius: 3px;
    background: #171717;
    color: #f0dd50;
    font-family: ui-monospace, 'SF Mono', Menlo, monospace;
    font-size: 0.75rem;
    line-height: 1;
  }
  .sys--taggo .sys__chip { border-radius: 3px; }
  .sys--taggo .sys__bar { background: #171717; }
  .sys--taggo .sys__radius-box { border-radius: 2px; background: #f0dd50; }

  /* TheEvents is a commerce catalogue: broad coral swatches, light dividers,
     and product-card-like specimens keep the focus on inventory and checkout. */
  .sys--theevents { gap: clamp(3.5rem, 2rem + 4vw, 5.5rem); }
  .sys--theevents .sys__group { padding-top: 1.5rem; border-top: 2px solid #e27e72; }
  .sys--theevents .sys__group h3 { color: #1a1a1a; }
  .sys--theevents .sys__index {
    display: inline-block;
    margin-right: 0.75rem;
    color: #bb6258;
    font-family: Inter, 'Inter Variable', system-ui, sans-serif;
    font-size: 0.8rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    vertical-align: 0.15em;
  }
  .sys--theevents .sys__swatches { grid-template-columns: repeat(auto-fill, minmax(min(8rem, 100%), 1fr)); }
  .sys--theevents .sys__chip { height: 5rem; border-radius: 12px; }
  .sys--theevents .sys__type li { border-color: #e8ddd9; }
  .sys--theevents .sys__radius-box { border-color: #e27e72; }

  /* Noma presents English and Arabic as paired surfaces, with the warm
     selection colour used for the edge and the touch-target specimens. */
  .sys--noma { gap: 2rem; }
  .sys--noma .sys__group {
    min-width: 0;
    padding: clamp(1.25rem, 1rem + 2vw, 2.5rem);
    border-left: 4px solid #5b3a29;
    border-radius: 0 16px 16px 0;
    background: #f8f3ee;
  }
  .sys--noma .sys__group h3 { color: #2a1d16; }
  .sys--noma .sys__index {
    display: inline-block;
    margin-right: 0.75rem;
    color: #7c5d4b;
    font-family: ui-monospace, monospace;
    font-size: 0.8rem;
    font-weight: 600;
  }
  .sys--noma .sys__chip { border-radius: 999px; }
  .sys--noma .sys__bar { background: #5b3a29; }
  .sys--noma .sys__radius-box { border-color: #5b3a29; background: #fff; }
  @media (max-width: 479px) {
    .sys--theevents .sys__swatches { grid-template-columns: repeat(2, minmax(0, 1fr)); }
    .sys--taggo .sys__group, .sys--noma .sys__group { padding: 1rem; }
  }
</style>
