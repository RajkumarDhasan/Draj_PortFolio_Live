---
// Switch a screen set between English and Arabic. A real single-choice group:
// choosing one clears the other, and the choice changes the screens shown.
import Screens from './Screens.astro';
import type { ImageMetadata } from 'astro';

type Item = { image: ImageMetadata; alt: string; title: string; caption: string };
interface Props {
  id: string;
  en: Item[];
  ar: Item[];
  label: string;
}
const { id, en, ar, label } = Astro.props;
---

<div class="lang" data-lang-root data-lang="en">
  <fieldset class="lang__switch">
    <legend>{label}</legend>
    <label><input type="radio" name={`${id}-lang`} value="en" checked /> English</label>
    <label><input type="radio" name={`${id}-lang`} value="ar" /> <span lang="ar">العربية</span> (Arabic)</label>
  </fieldset>
  <div class="lang__set lang__set--en"><Screens items={en} size="sm" /></div>
  <div class="lang__set lang__set--ar"><Screens items={ar} size="sm" /></div>
</div>

<script>
  document.querySelectorAll<HTMLElement>('[data-lang-root]').forEach((root) => {
    root.querySelectorAll<HTMLInputElement>('input[type="radio"]').forEach((input) => {
      input.addEventListener('change', () => {
        if (input.checked) root.dataset.lang = input.value;
      });
    });
  });
</script>

<style>
  .lang__switch {
    display: inline-flex;
    flex-wrap: wrap;
    gap: 0.5rem;
    margin: 0 0 1.5rem;
    padding: 0;
    border: 0;
  }
  legend {
    width: 100%;
    margin-bottom: 0.5rem;
    padding: 0;
    font-size: var(--fs-label);
    font-weight: 600;
    color: var(--paper-muted);
  }
  .lang__switch label {
    position: relative;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    min-height: 44px;
    padding: 0 1rem;
    border: 1px solid var(--paper-line);
    border-radius: 999px;
    background: var(--paper-raised);
    font-weight: 500;
    cursor: pointer;
  }
  .lang__switch label:has(input:checked) {
    border-color: var(--paper-ink);
    box-shadow: inset 0 0 0 1px var(--paper-ink);
  }
  .lang__switch input { accent-color: var(--paper-ink); width: 1rem; height: 1rem; margin: 0; }
  .lang[data-lang='en'] .lang__set--ar,
  .lang[data-lang='ar'] .lang__set--en { display: none; }
</style>
