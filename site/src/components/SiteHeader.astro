---
interface Props {
  home?: boolean;
  current?: 'about';
}
const { home = false, current } = Astro.props;
const base = import.meta.env.BASE_URL;
const prefix = home ? '' : base;
---

<header class="site-header" data-header>
  <div class="wrap site-header__inner">
    <a class="site-header__name" href={home ? '#top' : base}>Rajkumar Portfolio</a>
    <nav class="site-header__nav" aria-label="Main">
      <a href={`${prefix}#work`} class="site-header__work">Work</a>
      <a href={`${base}about/`} aria-current={current === 'about' ? 'page' : undefined}>About</a>
      <a href={`${prefix}#contact`}>Contact</a>
    </nav>
    <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color mode">
      <svg class="theme-toggle__icon theme-toggle__sun" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <circle cx="12" cy="12" r="4" />
        <path d="M12 2v2m0 16v2M2 12h2m16 0h2M4.9 4.9l1.4 1.4m11.4 11.4 1.4 1.4M19.1 4.9l-1.4 1.4M6.3 17.7l-1.4 1.4" />
      </svg>
      <svg class="theme-toggle__icon theme-toggle__moon" viewBox="0 0 24 24" width="18" height="18" fill="none" stroke="currentColor" stroke-width="1.6" stroke-linecap="round" stroke-linejoin="round" aria-hidden="true">
        <path d="M20.4 15.7A8.5 8.5 0 0 1 8.3 3.6 8.5 8.5 0 1 0 20.4 15.7Z" />
      </svg>
      <span class="theme-toggle__label" data-theme-label>Dark</span>
    </button>
  </div>
</header>

<nav class="mobile-nav" aria-label="Mobile navigation" data-mobile-nav data-home={home ? 'true' : 'false'}>
  <a href={home ? '#top' : base} data-mobile-tab="home" aria-current={home ? 'location' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="m3 10 9-7 9 7v10a1 1 0 0 1-1 1h-5v-7H9v7H4a1 1 0 0 1-1-1Z" /></svg>
    <span>Home</span>
  </a>
  <a href={`${prefix}#work`} data-mobile-tab="work" aria-current={!home && current !== 'about' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><rect x="3" y="4" width="18" height="16" rx="2" /><path d="M3 10h18m-12-6v16" /></svg>
    <span>Work</span>
  </a>
  <a href={`${base}about/`} data-mobile-tab="about" aria-current={current === 'about' ? 'page' : undefined}>
    <svg viewBox="0 0 24 24" aria-hidden="true"><circle cx="12" cy="8" r="3" /><path d="M5 21v-2a7 7 0 0 1 14 0v2" /></svg>
    <span>About</span>
  </a>
  <a href={`${prefix}#contact`} data-mobile-tab="contact">
    <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M4 6h16v12H4z" /><path d="m4 7 8 6 8-6" /></svg>
    <span>Contact</span>
  </a>
</nav>

<style>
  .site-header {
    position: fixed;
    inset: 0 0 auto 0;
    z-index: 40;
    /* min-height, not height: the bar grows if visitors enlarge text (WCAG 1.4.4) */
    min-height: var(--header-h);
    display: flex;
    border-bottom: 1px solid transparent;
    transition: background-color 0.3s var(--ease-out), border-color 0.3s var(--ease-out);
  }
  .site-header.is-solid {
    background: var(--header-surface);
    border-bottom-color: var(--line);
    -webkit-backdrop-filter: saturate(1.2) blur(10px);
    backdrop-filter: saturate(1.2) blur(10px);
  }
  .site-header__inner {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1rem;
  }
  .site-header__name,
  .site-header__nav a {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    text-decoration: none;
    /* underline grows from the left on hover */
    background: linear-gradient(currentColor, currentColor) 0 calc(100% - 10px) / 0 1px no-repeat;
    transition: background-size 0.35s var(--ease-out);
  }
  .site-header__name:hover,
  .site-header__nav a:hover { background-size: 100% 1px; }
  .site-header__name {
    font-family: var(--font-display);
    font-weight: 500;
    font-size: 1.0625rem;
    letter-spacing: -0.005em;
    white-space: nowrap;
  }
  .site-header__nav {
    display: flex;
    gap: clamp(1rem, 0.5rem + 2vw, 2rem);
    font-size: 0.9375rem;
    font-weight: 500;
  }
  .site-header__nav a[aria-current='page'] { background-size: 100% 1px; }
  .theme-toggle {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    gap: 0.5rem;
    min-width: 44px;
    min-height: 44px;
    padding: 0.35rem 0.65rem;
    border: 1px solid var(--line);
    border-radius: 999px;
    background: var(--stage-raised);
    font-size: 0.8125rem;
    font-weight: 600;
    cursor: pointer;
    white-space: nowrap;
    transition: background-color 0.3s, border-color 0.3s, transform 0.25s var(--ease-out);
  }
  .theme-toggle:hover { border-color: var(--ink-muted); transform: translateY(-2px); }
  .theme-toggle:active { transform: scale(0.97); }
  .theme-toggle__icon { flex: none; transition: transform 0.5s var(--ease-out); }
  :global(html[data-theme='light']) .theme-toggle__moon,
  :global(html[data-theme='dark']) .theme-toggle__sun { display: none; }
  .theme-toggle:hover .theme-toggle__icon { transform: rotate(30deg); }
  .mobile-nav { display: none; }
  @media (max-width: 760px) {
    .site-header__inner { gap: 0.5rem; }
    .site-header__nav { gap: 0.75rem; }
    .theme-toggle__label { display: none; }
  }
  @media (max-width: 599px) {
    .site-header__nav { display: none; }
    .mobile-nav {
      position: fixed;
      z-index: 45;
      inset: auto 0 0;
      display: grid;
      grid-template-columns: repeat(4, minmax(0, 1fr));
      min-height: calc(68px + env(safe-area-inset-bottom));
      padding: 0.25rem max(0.5rem, env(safe-area-inset-left)) env(safe-area-inset-bottom) max(0.5rem, env(safe-area-inset-right));
      border-top: 1px solid var(--line);
      background: var(--header-surface);
      -webkit-backdrop-filter: saturate(1.2) blur(14px);
      backdrop-filter: saturate(1.2) blur(14px);
    }
    .mobile-nav a {
      min-width: 0;
      min-height: 60px;
      display: grid;
      align-content: center;
      justify-items: center;
      gap: 0.1rem;
      border-radius: 12px;
      color: var(--ink-muted);
      font-size: 0.6875rem;
      font-weight: 600;
      line-height: 1.2;
      text-decoration: none;
      transition: color 0.2s, background-color 0.2s;
    }
    .mobile-nav a[aria-current] { color: var(--ink); background: var(--stage-raised); }
    .mobile-nav a svg { width: 21px; height: 21px; fill: none; stroke: currentColor; stroke-width: 1.65; stroke-linecap: round; stroke-linejoin: round; }
  }
  @media (min-width: 1200px) {
    .site-header__name { font-size: 1.125rem; }
  }
</style>

<script>
  const themeToggle = document.querySelector<HTMLButtonElement>('[data-theme-toggle]');
  const themeLabel = document.querySelector<HTMLElement>('[data-theme-label]');
  const root = document.documentElement;
  const syncTheme = () => {
    const theme = root.dataset.theme === 'light' ? 'light' : 'dark';
    if (themeLabel) themeLabel.textContent = theme === 'light' ? 'Light' : 'Dark';
    themeToggle?.setAttribute('aria-label', `Switch to ${theme === 'light' ? 'dark' : 'light'} mode`);
  };
  syncTheme();
  themeToggle?.addEventListener('click', () => {
    const next = root.dataset.theme === 'light' ? 'dark' : 'light';
    root.dataset.theme = next;
    document.querySelector<HTMLMetaElement>('meta[name="theme-color"]')?.setAttribute('content', next === 'light' ? '#f7f4ef' : '#17130f');
    try { localStorage.setItem('portfolio-theme', next); } catch { /* storage unavailable */ }
    syncTheme();
  });
  const header = document.querySelector<HTMLElement>('[data-header]');
  if (header) {
    const update = () => header.classList.toggle('is-solid', window.scrollY > 8);
    update();
    window.addEventListener('scroll', update, { passive: true });
  }
  const mobileNav = document.querySelector<HTMLElement>('[data-mobile-nav]');
  if (mobileNav?.dataset.home === 'true') {
    const tabs = Array.from(mobileNav.querySelectorAll<HTMLAnchorElement>('[data-mobile-tab]'));
    const updateTab = () => {
      const threshold = window.innerHeight * 0.45;
      const sections = ['contact', 'work'];
      const active = sections.find((id) => {
        const section = document.getElementById(id);
        return section && section.getBoundingClientRect().top <= threshold;
      }) ?? 'home';
      tabs.forEach((tab) => {
        if (tab.dataset.mobileTab === active) tab.setAttribute('aria-current', 'location');
        else tab.removeAttribute('aria-current');
      });
    };
    updateTab();
    window.addEventListener('scroll', updateTab, { passive: true });
    window.addEventListener('resize', updateTab, { passive: true });
  }
</script>
