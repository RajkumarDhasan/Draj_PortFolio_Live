---
// One phone frame for every standalone mobile screen on the site: a restrained
// iPhone 18 Pro silhouette drawn in CSS (no mockup image).
//
// Geometry, from Apple's published figures:
//   body 71.9 x 150.0 mm; display 1206 x 2622 px (aspect 0.45995).
//   At ~460 ppi the display is ~66.6 x 144.8 mm, so the bezel is ~2.6 mm on
//   every side, about 3.65% of the body width.
//   Display corner radius and Dynamic Island are drawn proportionally
//   (island ~32% of display width, ~9.4% tall, ~2.8% from the top).
//
// The screenshot is never cropped or scaled up: it is fitted whole inside the
// display (object-fit: contain), and any ratio difference shows the dark
// display fill. The display mask uses the same radius as the inner bezel
// edge, so there are no light wedges at the corners.
import { Image } from 'astro:assets';
import type { ImageMetadata } from 'astro';

type Shot = {
  image: ImageMetadata;
  alt: string;
  /** Bounds of the actual screen when an export also contains surrounding notes. */
  screen?: { x: number; y: number; width: number; height: number };
  /** A tall screen scrolls within the phone instead of shrinking to fit. */
  scroll?: boolean;
};

interface Props {
  steps: Shot[];
  /** 'player': images cycle via script; 'static': the page decides which screen shows */
  mode?: 'player' | 'static';
  /** Shared-element name for the homepage -> case-study transition */
  transition?: string;
  /** Decorative copy of screens described elsewhere on the page */
  decorative?: boolean;
  eager?: boolean;
  /** Responsive image hint; defaults to the frame's maximum rendered width */
  sizes?: string;
  /** 'stage' sits on the dark stage, 'paper' sits in the light case-study body */
  surface?: 'stage' | 'paper';
}

const {
  steps,
  mode = 'player',
  transition,
  decorative = false,
  eager = false,
  sizes = '(min-width: 768px) 336px, 70vw',
  surface = 'stage',
} = Astro.props;

const widthsFor = (w: number) => [...new Set([Math.min(w, 320), Math.min(w, 640), Math.min(w, 880)])];
const scroll = mode === 'static' && steps.length === 1 && steps[0]?.scroll === true;
---

<div
  class:list={['device', `device--${surface}`, scroll && 'device--scroll', transition && 'vt-device']}
  style={transition ? `view-transition-name: ${transition}` : undefined}
  data-device
  aria-hidden={decorative ? 'true' : undefined}
>
  <div class="device__body">
    <div class="device__display" tabindex={scroll ? 0 : undefined} role={scroll ? 'region' : undefined} aria-label={scroll ? 'Scrollable app screen' : undefined}>
      {
        steps.map((s, i) => (
          <Image
            src={s.image}
            alt={decorative ? '' : s.alt}
            widths={widthsFor(s.image.width)}
            sizes={sizes}
            quality={82}
            loading={eager || (mode === 'player' && i === 0) ? 'eager' : 'lazy'}
            decoding="async"
            class:list={['device__img', s.screen && 'device__img--screen', (mode === 'player' || steps.length === 1) && i === 0 && 'is-active']}
            style={s.screen ? `--screen-width: ${s.image.width / s.screen.width * 100}%; --screen-left: ${-s.screen.x / s.screen.width * 100}%; --screen-top: ${-s.screen.y / s.screen.height * 100}%;` : undefined}
            data-screen-index={i}
            aria-hidden={!decorative && mode === 'player' && i !== 0 ? 'true' : undefined}
          />
        ))
      }
    </div>
    <span class="device__island" aria-hidden="true"></span>
  </div>
</div>

<style>
  .device {
    width: var(--device-w, 18rem);
    max-width: 100%;
    container-type: inline-size;
  }
  /* All frame measurements are % of the body width (cqw) so the silhouette
     keeps its proportions at every size. */
  .device__body {
    --bezel: 3.65cqw;
    --display-r: 13cqw; /* ~14% of the display width */
    position: relative;
    aspect-ratio: 71.9 / 150;
    padding: var(--bezel);
    border-radius: calc(var(--display-r) + var(--bezel));
    background: #0b0a09;
    box-shadow:
      inset 0 0 0 1px rgba(242, 236, 226, 0.14),
      0 2.5rem 5rem -1.5rem rgba(0, 0, 0, 0.6);
  }
  .device--paper .device__body {
    box-shadow:
      inset 0 0 0 1px rgba(255, 255, 255, 0.12),
      0 0 0 1px rgba(30, 25, 20, 0.08),
      0 1.25rem 2.25rem -1.25rem rgba(30, 25, 20, 0.45);
  }
  .device__display {
    position: relative;
    height: 100%;
    overflow: hidden;
    border-radius: var(--display-r);
    clip-path: inset(0 round var(--display-r));
    background: #000;
  }
  .device__display :global(.device__img) {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
    opacity: 0;
    transition: opacity 0.6s var(--ease-out);
  }
  .device__display :global(.device__img.is-active) {
    opacity: 1;
  }
  .device__display :global(.device__img--screen) {
    inset: auto;
    top: var(--screen-top);
    left: var(--screen-left);
    width: var(--screen-width);
    height: auto;
    max-width: none;
    object-fit: fill;
  }
  .device--scroll .device__display {
    overflow-y: auto;
    overflow-x: hidden;
    scrollbar-width: none;
  }
  .device--scroll .device__display::-webkit-scrollbar { display: none; }
  .device--scroll .device__display :global(.device__img) {
    position: relative;
    inset: auto;
    display: block;
    width: 100%;
    height: auto;
  }
  .device__island {
    position: absolute;
    z-index: 1;
    top: 6.25cqw;
    left: 50%;
    width: 29.5cqw;
    height: 8.7cqw;
    transform: translateX(-50%);
    border-radius: 999px;
    background: #000;
    pointer-events: none;
  }
  @media (prefers-reduced-motion: reduce) {
    .device__display :global(.device__img) { transition: none; }
  }
</style>
