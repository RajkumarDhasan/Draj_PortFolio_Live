---
import HeroAtmosphere from './HeroAtmosphere.astro';
import { contact } from '../data/projects';

// Set to false to remove the atmospheric fade after visual review.
const SHOW_ATMOSPHERE = true;
---

<section class="hero" aria-labelledby="hero-title" data-hero>
  {SHOW_ATMOSPHERE && <HeroAtmosphere />}
  <div class="wrap hero__inner">
    {
      /* Each word group is its own mask so lines rise one after another at any
         width. The spaces between groups are explicit text nodes because Astro
         removes whitespace between elements when it compresses the HTML.
         "UX/UI -" never breaks apart (nowrap), so no line starts with "-". */
    }
    <h1 id="hero-title" class="hero__title">
      <span class="mask hero__keep"><span class="mask__inner">UX/UI -</span></span>{' '}<span class="mask"><span class="mask__inner">Product</span></span>{' '}<span class="mask"><span class="mask__inner">Designer</span></span>
    </h1>
    <p class="hero__line">I make complex products clear at every decision.</p>
    <p class="hero__support">Across websites and apps, from the first flow to the edge case and the system behind it.</p>
    <p class="hero__proof">
      Senior UI/UX Designer at Kief Consultancies &amp; Technologies in Abu Dhabi. My work spans websites and apps,
      including Taggo, TheEvents and ClinicClick.
    </p>
    <div class="hero__actions">
      <a class="btn hero__primary" href="#work">See the work</a>
      <a class="hero__link" href={`mailto:${contact.email}`}>Email me</a>
    </div>
  </div>
</section>

<style>
  .hero {
    position: relative;
    isolation: isolate;
    padding-top: calc(var(--header-h) + clamp(5rem, 3rem + 12vh, 11rem));
    padding-bottom: clamp(5rem, 2.5rem + 10vh, 9rem);
  }
  .hero__inner { position: relative; z-index: 1; }

  .hero__title {
    font-family: var(--font-display);
    font-weight: 480;
    font-size: var(--fs-hero);
    line-height: 1.06;
    letter-spacing: -0.022em;
  }

  .hero__keep { white-space: nowrap; }

  .hero.is-revealed .hero__title .mask:nth-of-type(2) .mask__inner {
    color: var(--hero-color-1);
    background: linear-gradient(110deg, var(--hero-color-1), var(--hero-color-2), var(--hero-color-1));
    background-size: 220% 100%;
    -webkit-background-clip: text;
    background-clip: text;
    -webkit-text-fill-color: transparent;
    animation: title-color 8s ease-in-out 1.2s infinite alternate;
  }
  @keyframes title-color {
    from { background-position: 0% 50%; }
    to { background-position: 100% 50%; }
  }
  @media (prefers-reduced-motion: reduce) {
    .hero.is-revealed .hero__title .mask:nth-of-type(2) .mask__inner { animation: none; }
  }


  .hero__line {
    max-width: 36ch;
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2.25rem);
    font-size: var(--fs-position);
    line-height: 1.4;
    color: var(--ink-soft);
    text-wrap: balance;
  }

  .hero__support {
    max-width: 40ch;
    margin-top: 0.75rem;
    font-size: clamp(1.0625rem, 1rem + 0.4vw, 1.25rem);
    line-height: 1.5;
    color: var(--ink-muted);
    text-wrap: pretty;
  }

  .hero__proof {
    max-width: 38rem;
    margin-top: clamp(1.5rem, 1rem + 1.5vw, 2rem);
    color: var(--ink-muted);
  }
  .hero__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem 1.75rem;
    margin-top: 2rem;
  }
  .hero__primary { background: var(--ink); color: var(--stage); }
  .hero__primary:hover { background: var(--ink-soft); }
  .hero__link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    font-weight: 600;
    text-decoration: underline;
    text-decoration-thickness: 1px;
    text-underline-offset: 0.3em;
  }
  .hero__link:hover { text-decoration-thickness: 2px; }

  /* Motion (only when scripts run; content is visible without them) */
  :global(html.js) .hero .mask__inner {
    transform: translateY(105%);
  }
  :global(html.js) .hero.is-revealed .mask__inner {
    transform: none;
    transition: transform 1.1s var(--ease-out) calc(var(--line, 0) * 100ms);
  }
  :global(html.js) .hero__line,
  :global(html.js) .hero__support {
    opacity: 0;
    transform: translateY(18px);
  }
  :global(html.js) .hero.is-revealed .hero__line,
  :global(html.js) .hero.is-revealed .hero__support {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s var(--ease-out) calc(var(--lines, 1) * 100ms + 0.25s),
      transform 0.9s var(--ease-out) calc(var(--lines, 1) * 100ms + 0.25s);
  }
  :global(html.js) .hero__proof,
  :global(html.js) .hero__actions {
    opacity: 0;
    transform: translateY(18px);
  }
  :global(html.js) .hero.is-revealed .hero__proof,
  :global(html.js) .hero.is-revealed .hero__actions {
    opacity: 1;
    transform: none;
    transition:
      opacity 0.9s var(--ease-out) calc(var(--lines, 1) * 100ms + 0.4s),
      transform 0.9s var(--ease-out) calc(var(--lines, 1) * 100ms + 0.4s);
  }
  :global(html.no-motion-fallback) .hero__proof,
  :global(html.no-motion-fallback) .hero__actions,
  :global(html.no-motion-fallback) .hero__line,
  :global(html.no-motion-fallback) .hero__support {
    opacity: 1;
    transform: none;
  }
  @media (max-width: 599px) {
    .hero {
      min-height: min(78svh, 42rem);
      padding-top: calc(var(--header-h) + clamp(5rem, 13vh, 8rem));
      padding-bottom: 6rem;
    }
    .hero__support,
    .hero__proof { display: none; }
    .hero__line { margin-top: 1.75rem; }
    .hero__actions { margin-top: 2.5rem; }
  }
</style>
